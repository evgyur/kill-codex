<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\kill-codex.ico</ApplicationIcon>
    <AssemblyName>CodexProcessKiller</AssemblyName>
    <RootNamespace>CodexProcessKiller</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Kill Codex</Product>
    <Description>One button to terminate Codex and ChatGPT processes on Windows 11.</Description>
    <Authors>Evgeny Yurchenko</Authors>
    <RepositoryUrl>https://github.com/evgyur/kill-codex</RepositoryUrl>
  </PropertyGroup>
</Project>
